# Meta Conversions API Configuration
VITE_META_ACCESS_TOKEN=your_meta_access_token_here

# Get your access token from:
# 1. Go to Meta Business Suite → Settings → Developers
# 2. Create an app or use existing one
# 3. Generate a System User access token with 'ads_management' permission
# 4. Copy the token here (it starts with "EAAJZC...")

# API URLs (all optional — defaults are baked into src/config/api.ts)
VITE_API_BASE_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
VITE_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
VITE_WEBHOOK_SECRET=fhg_orders_2024_secret
VITE_CAPI_ENDPOINT=https://apis.fulanihairsecrets.com/meta-capi.php

# Klump BNPL Configuration
VITE_KLUMP_PUBLIC_KEY=your_klump_public_key_here

# ERPNext Integration
VITE_ERPNEXT_INGEST_URL=https://vitalvida.systemforce.ng/api/method/vitalvida.orders.ingest
VITE_ERPNEXT_WEBHOOK_SECRET=
